# Central env example (copy into apps/api, apps/web, services/worker as needed)

# Web → API base
NEXT_PUBLIC_API_BASE=

# API/Worker
DATABASE_URL=
# Use rediss:// for Upstash TLS; docker-compose uses redis://redis:6379/0 for local dev
REDIS_URL=rediss://:REPLACE_ME@HOST:PORT
JWT_SECRET=
TOKEN_CRYPTO_KEY=
NWS_USER_AGENT="Fantasy Edge (contact: you@example.com)"
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=
ALLOW_DEBUG_USER=true|false
CORS_ORIGINS=
SESSION_COOKIE_NAME=edge_session
SESSION_TTL_SECONDS=2592000
# Set for cross-subdomain SSR in prod
# SESSION_COOKIE_DOMAIN=.westfam.media
WEB_BASE_URL=
LIVE_POLL_INTERVAL=8000
LIVE_PROVIDER=yahoo
